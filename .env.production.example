# Konfigurasi production untuk stack Docker (compose.yml). Salin ke .env lalu isi nilai bertanda <...>.
#   cp .env.production.example .env
# File .env berisi rahasia: jangan di-commit, batasi aksesnya (chmod 600 .env).

APP_NAME="Carbon Tracker"
APP_ENV=production
# Buat dengan: make key  (atau: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>
# Alamat SPA untuk tautan di email notifikasi (sama dengan APP_URL karena satu origin)
FRONTEND_URL=https://<domain-anda>
APP_BUSINESS_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

SANCTUM_EXPIRATION=1440
BCRYPT_ROUNDS=12

# Log ke stderr container (compose.yml juga memaksa ini); lihat dengan: make logs
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (service mysql di compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=carbon_tracker
# Bukan root: user ini dibuat otomatis oleh image MySQL saat volume masih kosong
DB_USERNAME=carbon
DB_PASSWORD=<password-panjang-acak>
# Password root MySQL TIDAK di sini: dibuat `make secrets` di secrets/db_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
FILESYSTEM_DISK=local

# Laporan dan email diproses service queue
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

API_RATE_LIMIT=120

# SPA dan API satu origin (nginx di service web), jadi CORS cukup domain sendiri
CORS_ALLOWED_ORIGINS=https://<domain-anda>

# --- Email notifikasi approval ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.penyedia-email>
MAIL_PORT=587
MAIL_USERNAME=<user-smtp>
MAIL_PASSWORD=<password-smtp>
MAIL_FROM_ADDRESS="carbon-tracker@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sentry (opsional): kosongkan untuk mematikan ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Contoh 0.1 = 10% request dilacak performanya; kosong = tidak melacak performa
SENTRY_TRACES_SAMPLE_RATE=
# DSN project Sentry untuk frontend (dibaca saat image web di-build)
VITE_SENTRY_DSN=

# --- Docker ---
# HTTPS otomatis: aktifkan baris ini (Caddy dari compose.tls.yml ikut berjalan)
# COMPOSE_FILE=compose.yml:compose.tls.yml
# Lokasi clone repo carbon-tracker-frontend (relatif ke folder ini)
FRONTEND_PATH=./carbon-tracker-frontend
# Tag image; isi dengan versi rilis (mis. tag git) agar rollback mudah
APP_VERSION=local
# Port HTTP di host (tanpa compose.tls.yml); HTTP_BIND=127.0.0.1 bila ada reverse proxy lain di host
HTTP_PORT=80
HTTP_BIND=0.0.0.0

# HTTPS otomatis lewat Caddy (compose.tls.yml)
DOMAIN=<domain-anda>
ACME_EMAIL=<email-admin>

# --- Backup harian (service backup) ---
# 19:00 UTC = 02:00 WIB
BACKUP_TIME_UTC=19:00
BACKUP_RETENTION_DAYS=14
BACKUP_PATH=./backups

# --- Backup off-site (service offsite, docs/DEPLOY.md) ---
# Kosong = nonaktif. Kunci publik age (age1...) dari `make offsite-keygen`;
# kunci privatnya disimpan di LUAR server, hanya dipakai saat restore.
OFFSITE_AGE_RECIPIENT=
# Object storage S3-compatible. PROVIDER sesuai rclone: AWS, Cloudflare (R2), Wasabi, Minio, atau Other
# (mis. Backblaze B2, object storage lokal). ENDPOINT kosong untuk AWS.
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Folder di dalam bucket, interval sinkron (menit), dan masa simpan:
# N harian terakhir + backup pertama setiap bulan selama N bulan
OFFSITE_PREFIX=carbon-tracker
OFFSITE_INTERVAL_MINUTES=30
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_MONTHLY=12

# --- Peringatan backup (php artisan backups:check, tiap jam, email ke admin aktif) ---
# Backup harian dianggap terlambat setelah N jam tanpa sukses; off-site setelah N jam tanpa sinkron sukses
BACKUP_MAX_AGE_HOURS=26
OFFSITE_MAX_AGE_HOURS=6
